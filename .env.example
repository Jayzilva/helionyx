# Helionyx configuration. Copy to .env or export these variables.

# Workspace for the SQLite database, Parquet artefacts, HTTP cache and exports.
# File paths given to tools must be inside it.
HNX_WORKSPACE=~/.helionyx

# 1 = use only cached and bundled data; make no network calls.
HNX_OFFLINE=0

# Maximum concurrent jobs per user.
HNX_MAX_JOBS=2

# Job time limit in seconds.
HNX_JOB_TIMEOUT_S=900

# REopt API v3 (optional). Register at developer.nlr.gov.
HNX_REOPT_API_KEY=
# Base URL of the REopt API.
HNX_REOPT_URL=https://developer.nlr.gov/api/reopt/stable
# Path to a recorded REopt results JSON to replay instead of calling the API (tests only).
HNX_REOPT_FIXTURE=

# Log level: DEBUG, INFO, WARNING, ERROR.
HNX_LOG_LEVEL=INFO
